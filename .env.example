# 1. Copy this file and name the copy ".env"  (just ".env", nothing before the dot)
# 2. Get a FREE key at https://aistudio.google.com/apikey (use a personal Google account)
# 3. Paste it below, replacing the placeholder. Remember: never share or commit this file!

PROVIDER=gemini
GEMINI_API_KEY=paste-your-key-here
MODEL=gemini-3.5-flash-lite